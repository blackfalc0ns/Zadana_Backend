{
  "ConnectionStrings": {
    "DefaultConnection": "__SET_VIA_ENV__ConnectionStrings__DefaultConnection"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "__SET_VIA_ENV__JwtSettings__Secret",
    "Issuer": "ZadanaApi",
    "Audience": "ZadanaClients",
    "ExpiryMinutes": 60
  },
  "Swagger": {
    "EnableInProduction": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Email": {
    "FromEmail": "support@zadna0.com",
    "FromName": "Zadna",
    "SupportEmail": "support@zadna0.com",
    "HelloEmail": "hello@zadna0.com",
    "InfoEmail": "info@zadna0.com",
    "ContactEmail": "contact@zadna0.com",
    "LogoUrl": "https://ik.imagekit.io/fnyx4x87z/logo/%D8%B4%D9%81%D8%A7%D9%81%20(4).png",
    "OtpHeroImageUrl": "https://ik.imagekit.io/fnyx4x87z/logo/ChatGPT%20Image%20May%2020,%202026,%2004_58_05%20PM.png?tr=w-640",
    "OtpHeroImageUrlAr": "https://ik.imagekit.io/fnyx4x87z/email_tamplet/ChatGPT%20Image%20May%2025,%202026,%2003_09_30%20PM.png",
    "OtpHeroImageUrlEn": "https://ik.imagekit.io/fnyx4x87z/email_tamplet/ChatGPT%20Image%20May%2025,%202026,%2003_11_15%20PM.png",
    "PasswordResetHeroImageUrlAr": "https://ik.imagekit.io/fnyx4x87z/email_tamplet/ChatGPT%20Image%20May%2025,%202026,%2004_08_00%20PM.png",
    "PasswordResetHeroImageUrlEn": "https://ik.imagekit.io/fnyx4x87z/email_tamplet/ChatGPT%20Image%20May%2025,%202026,%2004_12_23%20PM.png",
    "Smtp": {
      "Host": "__SET_VIA_ENV__Email__Smtp__Host",
      "Port": 587,
      "Security": "StartTls",
      "Username": "__SET_VIA_ENV__Email__Smtp__Username",
      "Password": "__SET_VIA_ENV__Email__Smtp__Password",
      "TimeoutSeconds": 30,
      "RequireAuthentication": true
    }
  },
  "VendorPanel": {
    "PublicBaseUrl": "__SET_VIA_ENV__VendorPanel__PublicBaseUrl"
  },
  "WapilotOtp": {
    "Enabled": false,
    "BaseUrl": "https://api.wapilot.net",
    "SendMessagePath": "/api/v2/{instance_id}/send-message",
    "InstanceId": "__SET_VIA_ENV__WapilotOtp__InstanceId",
    "ApiKey": "__SET_VIA_ENV__WapilotOtp__ApiKey",
    "DefaultCountryCode": "+20",
    "MessageTemplateAr": "رمز تحقق زادنا:\n```{0}```\n\nلا تشارك هذا الرمز مع أي شخص.",
    "MessageTemplateEn": "ZADANA verification code:\n```{0}```\n\nDo not share this code with anyone.",
    "WebhookSecret": ""
  },
  "WhatsAppCloudOtp": {
    "Enabled": false,
    "BaseUrl": "https://graph.facebook.com",
    "GraphVersion": "v23.0",
    "PhoneNumberId": "__SET_VIA_ENV__WhatsAppCloudOtp__PhoneNumberId",
    "AccessToken": "__SET_VIA_ENV__WhatsAppCloudOtp__AccessToken",
    "DefaultCountryCode": "+20",
    "TemplateName": "zadana_otp_copy_code",
    "LanguageCode": "en_US",
    "CopyCodeButtonIndex": 0
  },
  "ImageKit": {
    "PublicKey": "__SET_VIA_ENV__ImageKit__PublicKey",
    "PrivateKey": "__SET_VIA_ENV__ImageKit__PrivateKey",
    "UrlEndpoint": "__SET_VIA_ENV__ImageKit__UrlEndpoint"
  },
  "FileStorage": {
    "Provider": "ImageKit",
    "Local": {
      "RootPath": "",
      "PublicBaseUrl": "",
      "ConvertImagesToWebp": true,
      "WebpQuality": 82,
      "MaxWidth": 2000,
      "MaxHeight": 2000,
      "MaxPixelCount": 40000000,
      "MaxConcurrentImageProcessors": 2
    }
  },
  "Moyasar": {
    "Enabled": true,
    "BaseUrl": "https://api.moyasar.com/v1/",
    "PublishableKey": "__SET_VIA_ENV__Moyasar__PublishableKey",
    "SecretKey": "__SET_VIA_ENV__Moyasar__SecretKey",
    "WebhookSecret": "__SET_VIA_ENV__Moyasar__WebhookSecret",
    "CallbackUrl": "__SET_VIA_ENV__Moyasar__CallbackUrl",
    "EnabledMethods": [ "creditcard", "applepay", "samsungpay", "stcpay" ],
    "SupportedNetworks": [ "mada", "visa", "mastercard" ],
    "Currency": "SAR",
    "Payouts": {
      "Enabled": false,
      "SourceId": "",
      "PayoutAccount": {
        "CompanyCode": "",
        "Certificate": "",
        "PrivateKey": ""
      },
      "DefaultCountry": "SA",
      "DefaultCity": "Riyadh",
      "VendorPurpose": "payment_to_merchant",
      "DriverPurpose": "payroll_benefits",
      "PollingIntervalSeconds": 300,
      "UnknownRetryDelaySeconds": 120,
      "ProcessingAlertAfterMinutes": 60
    }
  },
  "Payments": {
    "CardSessionExpirationSeconds": 1800
  },
  "BankTransfer": {
    "Enabled": true,
    "ProviderName": "BankTransfer",
    "BankName": "__SET_VIA_ENV__BankTransfer__BankName",
    "AccountHolderName": "__SET_VIA_ENV__BankTransfer__AccountHolderName",
    "Iban": "__SET_VIA_ENV__BankTransfer__Iban",
    "AccountNumber": "__SET_VIA_ENV__BankTransfer__AccountNumber",
    "WebhookSecret": "__SET_VIA_ENV__BankTransfer__WebhookSecret",
    "ExpirationMinutes": 1440
  },
  "OneSignal": {
    "Enabled": true,
    "AppId": "__SET_VIA_ENV__OneSignal__AppId",
    "RestApiKey": "__SET_VIA_ENV__OneSignal__RestApiKey",
    "DriverAppId": "__SET_VIA_ENV__OneSignal__DriverAppId",
    "DriverRestApiKey": "__SET_VIA_ENV__OneSignal__DriverRestApiKey",
    "AdminWebAppId": "__SET_VIA_ENV__OneSignal__AdminWebAppId",
    "AdminWebRestApiKey": "__SET_VIA_ENV__OneSignal__AdminWebRestApiKey",
    "AdminDefaultWebUrl": "__SET_VIA_ENV__OneSignal__AdminDefaultWebUrl",
    "BaseUrl": "https://api.onesignal.com",
    "DefaultWebUrl": "__SET_VIA_ENV__OneSignal__DefaultWebUrl",
    "MobileHeadsUpAndroidChannelId": "zadana_heads_up_notifications",
    "MobileHeadsUpExistingAndroidChannelId": "zadana_heads_up_notifications",
    "MobileHeadsUpPriority": 10,
    "MobileStandardAndroidChannelId": "zadana_driver_general_notifications",
    "MobileStandardExistingAndroidChannelId": "zadana_driver_general_notifications",
    "MobileStandardPriority": 10,
    "OrderUpdatesAndroidChannelId": "zadana_order_updates_realtime_v2",
    "OrderUpdatesExistingAndroidChannelId": "zadana_order_updates_realtime_v2",
    "OrderUpdatesPriority": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seeding": {
    "EnableOnStartup": false,
    "ResetOnStartup": false,
    "EnableRemoteEndpoints": false,
    "ManagementKey": "__SET_VIA_ENV__Seeding__ManagementKey"
  },
  "FinancialSettings": {
    "DriverCommissionRatePercent": 15.0,
    "WeeklySettlementDayOfWeek": "Sunday",
    "BiweeklySettlementDaysOfMonth": [ 1, 16 ],
    "MonthlySettlementDayOfMonth": 0,
    "PlatformWalletOwnerId": "00000000-0000-0000-0000-000000000001"
  },
  "Caching": {
    "MaximumPayloadBytes": 262144,
    "MaximumKeyLength": 1024,
    "Redis": {
      "RequireInProduction": true,
      "ConnectionString": "",
      "InstanceName": "zadana"
    },
    "Durations": {
      "GeographySeconds": 86400,
      "PublicCatalogMetadataSeconds": 1800,
      "BrowseBaseSeconds": 120,
      "HomePublicSeconds": 120,
      "FavoriteSetSeconds": 60,
      "PurchaseProfileSeconds": 300,
      "AdminDashboardSeconds": 30
    }
  },
  "Security": {
    "SearchableHashKey": "",
    "RunNationalIdHashBackfill": false
  },
  "RateLimiter": {
    "DisableGlobal": false,
    "GlobalPermitsPerSecond": 200,
    "PublicReadPermitsPerSecond": 250
  },
  "DatabasePerformance": {
    "LogSlowQueries": true,
    "SlowQueryThresholdMilliseconds": 750,
    "MaxLoggedCommandTextLength": 800
  },
  "OpenTelemetry": {
    "ServiceName": "zadana-api",
    "ServiceNamespace": "zadana",
    "OtlpEndpoint": ""
  }
}
