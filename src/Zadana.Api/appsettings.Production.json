{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Swagger": {
    "EnableInProduction": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://zadana.com",
      "https://zadana.runasp.net",
      "https://zadan-super-panel.vercel.app",
      "https://zadana-vendor-panel.vercel.app"
    ]
  },
  "Caching": {
    "Redis": {
      "RequireInProduction": false,
      "InstanceName": "zadana-prod"
    }
  }
}
