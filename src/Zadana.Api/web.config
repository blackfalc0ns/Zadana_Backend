<?xml version="1.0" encoding="utf-8"?>
<!--
  هذا الملف هو القالب المنشور في git. الأسرار الفعلية تُضاف على الخادم
  مباشرة كـ environment variables داخل <environmentVariables>.

  راجع deploy/web.config.production.example للحصول على نسخة كاملة بقيم
  وهمية تنسخها إلى الخادم.

  بعد النشر:
  1. افتح File Manager في لوحة runasp.net.
  2. عدّل web.config على الخادم وأضف الأسرار.
  3. اضغط Restart Application Pool.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        SignalR must be allowed to upgrade authenticated hub connections to
        WebSockets on IIS. Keep this in the source web.config because
        `dotnet publish` copies this file to the deployment output; having the
        setting only in the production example leaves real deployments using
        long polling, which can be buffered or timed out by the hosting proxy.
      -->
      <webSocket enabled="true" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Zadana.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            الأسرار التالية تُضاف على الخادم فقط. اتركها فارغة في git.
            مثال (انسخ من deploy/web.config.production.example):

            <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=...;Encrypt=True;..." />
            <environmentVariable name="JwtSettings__Secret" value="..." />
            <environmentVariable name="Moyasar__SecretKey" value="..." />
            ... إلخ

            لاحظ: الـ '__' (شرطتان سفليتان) تستبدل ':' في أسماء إعدادات .NET.
          -->
        </environmentVariables>
      </aspNetCore>
      <httpErrors errorMode="DetailedLocalOnly" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
