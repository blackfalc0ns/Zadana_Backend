{
  "document_name": "Mobile Customer Orders and Moyasar Payment Integration Guide",
  "version": "2.0.0",
  "updated_at_utc": "2026-05-19T00:00:00Z",
  "provider": "moyasar",
  "purpose": "Structured integration guide for mobile developers to implement customer orders, Moyasar card payment, retry payment, delete order, cancel order, and cancellation reasons using backend-driven flags.",
  "core_rules": {
    "legacy_paymob_removed": true,
    "vendor_visibility": {
      "pending_payment_orders_visible_to_vendor": false,
      "visible_after_payment_success_status": "PendingVendorAcceptance"
    },
    "mobile_must_follow_backend_flags": true,
    "action_flags": [
      "can_retry_payment",
      "can_delete",
      "can_cancel"
    ],
    "moyasar_payment_rule": "Render Moyasar Form using payment.provider_config. Do not treat payment.iframe_url as a URL."
  },
  "auth": {
    "required_headers": [
      {
        "name": "Authorization",
        "value_format": "Bearer <token>",
        "required": true
      },
      {
        "name": "X-Device-Id",
        "value_format": "<device-id>",
        "required": false,
        "recommended_for": [
          "place order",
          "retry payment"
        ]
      }
    ]
  },
  "moyasar_provider_config_mapping": {
    "publishableKey": "publishable_api_key",
    "callbackUrl": "callback_url",
    "supportedNetworks": "supported_networks",
    "amount": "amount",
    "currency": "currency",
    "description": "description",
    "methods": "methods",
    "metadata": "metadata"
  },
  "payment_session_response_example": {
    "payment": {
      "id": "33333333-3333-3333-3333-333333333333",
      "provider": "moyasar",
      "status": "pending",
      "iframe_url": "RenderMoyasarForm",
      "provider_reference": "",
      "provider_config": {
        "publishableKey": "pk_test_or_live",
        "amount": 12500,
        "currency": "SAR",
        "description": "Order ORD-000001",
        "callbackUrl": "https://your-api.com/api/payments/moyasar/verify",
        "methods": ["creditcard"],
        "supportedNetworks": ["mada", "visa", "mastercard"],
        "metadata": {
          "order_id": "11111111-1111-1111-1111-111111111111",
          "payment_id": "33333333-3333-3333-3333-333333333333",
          "order_number": "ORD-000001"
        }
      }
    }
  },
  "frontend_must_not": [
    "use /api/payments/paymob/*",
    "open accept.paymob.com",
    "construct payment URLs manually",
    "send card data to Zadana backend",
    "store Moyasar SecretKey or WebhookSecret in the app",
    "mark the order as paid locally",
    "create a new order for retry"
  ],
  "endpoints": [
    {
      "name": "get_checkout_summary",
      "method": "GET",
      "path": "/api/checkout/summary?payment_method=card",
      "purpose": "Check payment methods, delivery, and totals before placing a card order."
    },
    {
      "name": "place_order",
      "method": "POST",
      "path": "/api/orders",
      "purpose": "Create an order. For card orders, the response includes Moyasar provider_config.",
      "request_example": {
        "vendor_id": "11111111-1111-1111-1111-111111111111",
        "address_id": "22222222-2222-2222-2222-222222222222",
        "delivery_slot_id": "asap",
        "payment_method": "card",
        "promo_code": null,
        "notes": null
      }
    },
    {
      "name": "retry_payment",
      "method": "POST",
      "path": "/api/orders/{orderId}/retry-payment",
      "purpose": "Create a new Moyasar payment form config for the same pending unpaid card order.",
      "call_only_when": {
        "can_retry_payment": true
      }
    },
    {
      "name": "moyasar_verify_callback",
      "method": "GET",
      "path": "/api/payments/moyasar/verify?id={moyasar_payment_id}",
      "purpose": "Moyasar callback. Backend verifies payment with Moyasar, then mobile refreshes the order."
    },
    {
      "name": "get_active_orders",
      "method": "GET",
      "path": "/api/orders/active",
      "purpose": "Refresh active customer orders after payment."
    },
    {
      "name": "get_order_details",
      "method": "GET",
      "path": "/api/orders/{orderId}",
      "purpose": "Refresh a specific order after payment."
    },
    {
      "name": "delete_unpaid_pending_order",
      "method": "DELETE",
      "path": "/api/orders/{orderId}",
      "call_only_when": {
        "can_delete": true
      }
    },
    {
      "name": "cancel_order",
      "method": "POST",
      "path": "/api/orders/{orderId}/cancel",
      "call_only_when": {
        "can_cancel": true
      }
    }
  ],
  "expected_common_errors": {
    "payment": [
      "PAYMENT_UNAVAILABLE",
      "PAYMENT_METHOD_NOT_SUPPORTED",
      "PAYMENT_AMOUNT_MISMATCH",
      "PAYMENT_ORDER_MISMATCH"
    ],
    "retry_payment": [
      "ORDER_PAYMENT_RETRY_NOT_ALLOWED",
      "ORDER_ALREADY_PAID",
      "PAYMENT_UNAVAILABLE"
    ],
    "delete_order": [
      "ORDER_DELETE_NOT_ALLOWED",
      "ORDER_ALREADY_PAID",
      "ORDER_NOT_PENDING_PAYMENT"
    ],
    "cancel_order": [
      "ORDER_CANNOT_BE_CANCELLED"
    ]
  },
  "acceptance_checklist": [
    "Card place-order response returns payment.provider = moyasar.",
    "The app renders Moyasar Form from provider_config.",
    "The app does not use Paymob URLs or endpoints.",
    "The app refreshes order state after callback or WebView close.",
    "Retry payment uses the same orderId.",
    "Secret keys are never shipped in the app."
  ]
}

